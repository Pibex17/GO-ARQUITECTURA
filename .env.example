# .env.example — copie este archivo a .env y complete los valores de SU máquina.
# .env no se sube al repositorio (está en .gitignore); este archivo sí.
# Secreto: la cadena de conexión lleva la contraseña. Complete las credenciales
# de su PostgreSQL local; no use las de otro entorno ni las del .env real.
# Para Docker Compose, consulte las credenciales configuradas en ese entorno.
DATABASE_URL=host=localhost user=CAMBIE_USUARIO password=CAMBIE_CLAVE dbname=canchas port=5432
# Secreto: firma los tokens de sesión. Genere una clave aleatoria propia de al menos 32 bytes.
# No use CAMBIE_ESTO ni otra clave de ejemplo: el servidor rechaza marcadores y claves cortas.
# Sin valor por defecto. No guarde una clave real en este archivo.
CLAVE_FIRMA=
# Configuración: cambia por máquina. Si se omite, el servidor usa 8080.
PUERTO=8080
# Configuración: cuántos segundos espera el servidor antes de cortar. Si se omite, 5.
TIEMPO_ESPERA_SEGUNDOS=5
