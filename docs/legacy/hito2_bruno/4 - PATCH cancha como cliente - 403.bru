meta {
  name: 4 - PATCH cancha como cliente - 403
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/canchas/{{canchaId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{clienteToken}}
  Content-Type: application/json
}

body:json {
  {}
}

tests {
  test("4 - el rol cliente recibe 403 antes de leer el cuerpo", function() {
    expect(res.status).to.equal(403);
    expect(res.body.ok).to.equal(false);
    expect(res.body.error.codigo).to.equal("permiso_denegado");
  });
}
