meta {
  name: 0.1 - Preparacion - canchas admin
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/canchas
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

script:post-response {
  const lista = (res.body && Array.isArray(res.body.datos)) ? res.body.datos : [];
  if (res.status === 200 && lista.length > 0) {
    bru.setVar("canchaId", lista[0].ID);
  }
}

tests {
  test("0.1 - canchas del administrador responde 200", function() {
    expect(res.status).to.equal(200);
    expect(res.body.ok).to.equal(true);
    expect(res.body.datos).to.be.an("array");
  });

  test("0.1 - guarda una cancha propia", function() {
    const canchaId = Number(bru.getVar("canchaId"));
    expect(canchaId).to.be.greaterThan(0);
  });
}
