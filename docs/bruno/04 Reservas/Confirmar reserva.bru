meta {
  name: Confirmar reserva
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/reservas/{{reservaId}}/estado
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{tokenAdmin}}
}

body:json {
  {
    "NuevoEstado": "confirmada"
  }
}

tests {
  test("202 aceptado", function() {
    expect(res.status).to.equal(202);
  });
}
