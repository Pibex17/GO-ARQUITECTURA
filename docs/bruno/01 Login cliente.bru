meta {
  name: Login cliente
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {
    "usuario": "ana",
    "clave": "ana-2026"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("tokenCliente", res.body.datos.token);
  }
}

tests {
  test("200 y token", function() {
    expect(res.status).to.equal(200);
    expect(res.body.datos.token).to.be.a("string");
  });
}
