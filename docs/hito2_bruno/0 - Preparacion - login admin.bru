meta {
  name: 0 - Preparacion - login admin
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "usuario": "luis",
    "clave": "luis-2026"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.datos && res.body.datos.token) {
    bru.setVar("adminToken", res.body.datos.token);
  }
}

tests {
  test("0 - login de luis responde 200", function() {
    expect(res.status).to.equal(200);
    expect(res.body.ok).to.equal(true);
  });

  test("0 - guarda el JWT del administrador", function() {
    const token = bru.getVar("adminToken");
    expect(token).to.be.a("string");
    expect(token.length).to.be.greaterThan(0);
  });
}
