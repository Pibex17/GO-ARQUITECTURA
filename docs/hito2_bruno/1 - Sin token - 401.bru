meta {
  name: 1 - Sin token - 401
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/reservas
  body: none
  auth: none
}

tests {
  test("1 - ruta protegida sin token responde 401", function() {
    expect(res.status).to.equal(401);
    expect(res.body.ok).to.equal(false);
    expect(res.body.error.codigo).to.equal("falta_token");
  });
}
