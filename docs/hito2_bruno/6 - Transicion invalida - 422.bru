meta {
  name: 6 - Transicion invalida - 422
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/reservas/{{reservaId}}/estado
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
  Content-Type: application/json
}

body:json {
  {
    "NuevoEstado": "confirmada"
  }
}

tests {
  test("6 - pendiente a confirmada responde 422", function() {
    expect(res.status).to.equal(422);
    expect(res.body.ok).to.equal(false);
    expect(res.body.error.codigo).to.equal("transicion_invalida");
  });
}
